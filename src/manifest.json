{
  "manifest_version": 3,
  "name": "Carat — tab autocomplete for the web",
  "version": "0.1.0",
  "description": "Ghost-text autocomplete in any text field, grounded in Chrome's accessibility tree. Press Tab to accept.",
  "permissions": ["debugger", "storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Carat"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Enable or disable Carat"
    }
  }
}
